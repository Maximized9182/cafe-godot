#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

wiiu_files = [
    "godot_wiiu.cpp",
    "os_wiiu.cpp",
    "joypad_wiiu.cpp",
    "keyboard_mouse_wiiu.cpp",
    "display_server_wiiu.cpp",
    "rasterizer_wiiu.cpp",
    "rasterizer_canvas_wiiu.cpp",
    "rasterizer_scene_wiiu.cpp",
    "texture_storage_wiiu.cpp",
    "mesh_storage_wiiu.cpp",
    "material_storage_wiiu.cpp",
    "audio_driver_wiiu.cpp",
    "wiiu_gx2.c",
    "crash_font_data.c",
    "stats_font_data.c",
    "wiiu_system_font.cpp",
    "wiiu_stats.cpp",
    "atomic64.c",
    "posix_stubs.c",
    "crash_log.c",
    "tls_keys.c",
    "wiiu_console.c",
]

# wut.specs links with --emit-relocs (elf2rpl needs the relocations), which ld can't
# combine with the -s that SConstruct adds for builds without debug symbols.
env["LINKFLAGS"] = [flag for flag in env["LINKFLAGS"] if flag != "-s"]

# Route abort() and sbrk through crash_log.c (crash screen, the stats overlay's
# heap size); with wiiu_heap_check=yes, every allocation too (heap check).
env.Append(LINKFLAGS=["-Wl,--wrap=abort,--wrap=_sbrk_r", "-Wl,-Map=bin/godot.wiiu.map"])
if env["wiiu_heap_check"]:
    env.Append(LINKFLAGS=["-Wl,--wrap=malloc,--wrap=calloc,--wrap=realloc,--wrap=free"])

# Embed the compiled GX2 shaders (shaders/*.gsh) as C arrays:
# wiiu_shader_<name>[] and wiiu_shader_<name>_size.
def make_shader_c(target, source, env):
    import os

    with open(str(target[0]), "w", encoding="utf-8") as out:
        out.write("// Generated by platform/wiiu/SCsub from shaders/*.gsh. Do not edit.\n")
        out.write("#include <stddef.h>\n#include <stdint.h>\n\n")
        for src in source:
            name = os.path.splitext(os.path.basename(str(src)))[0]
            with open(str(src), "rb") as f:
                data = f.read()
            out.write("const uint8_t wiiu_shader_%s[] __attribute__((aligned(0x100))) = {\n" % name)
            for i in range(0, len(data), 16):
                out.write("\t" + ", ".join("0x%02x" % b for b in data[i : i + 16]) + ",\n")
            out.write("};\nconst size_t wiiu_shader_%s_size = %d;\n\n" % (name, len(data)))
    return None


wiiu_shaders = env.Command(
    "wiiu_shaders.gen.c", ["shaders/texture.gsh", "shaders/color.gsh", "shaders/msdf.gsh"], env.Run(make_shader_c)
)

# wiiu_system_font.cpp rasterises the system font with Godot's bundled FreeType.
env.Prepend(CPPPATH=["#thirdparty/freetype/include"])

prog = env.add_program("#bin/godot", wiiu_files + wiiu_shaders)

# .text must stay under 32 MB: past that, ld inserts long-branch stubs and the
# console runs the .rpx wrong (2026-11-14: with CafeGLSL linked, .text was
# 36.5 MB and a static constructor's call to __cxa_atexit jumped back into the
# constructor list; startup looped until MEM2 ran out). Fail the build instead.
def check_text_size(target, source, env):
    import subprocess

    out = subprocess.run(["powerpc-eabi-objdump", "-h", str(source[0])], capture_output=True, text=True).stdout
    for line in out.splitlines():
        parts = line.split()
        if len(parts) > 2 and parts[1] == ".text":
            size = int(parts[2], 16)
            print("wiiu: .text is %.2f MB (limit 32 MB, %.2f MB left)" % (size / 1048576.0, (0x2000000 - size) / 1048576.0))
            if size >= 0x2000000:
                print("wiiu: error: .text is 32 MB or larger; the .rpx would not run. Drop modules or features.")
                return 1
    return 0


# Convert the linked ELF into a Cafe OS executable (.rpx). Clang's objects carry
# .note.GNU-stack sections, which elf2rpl can't lay out, so they're stripped first.
rpx = env.Command(
    str(prog[0]).replace(".elf", ".rpx"),
    prog,
    [
        check_text_size,
        "powerpc-eabi-objcopy --remove-section=.note.GNU-stack $SOURCE ${TARGET.base}.stripped.elf",
        "elf2rpl ${TARGET.base}.stripped.elf $TARGET",
    ],
)
env.Default(rpx)
