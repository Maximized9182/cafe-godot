#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

wiiu_files = [
    "godot_wiiu.cpp",
    "os_wiiu.cpp",
    "joypad_wiiu.cpp",
    "display_server_wiiu.cpp",
    "rasterizer_wiiu.cpp",
    "audio_driver_wiiu.cpp",
    "wiiu_gx2.c",
    "crash_font_data.c",
    "wiiu_system_font.cpp",
    "wiiu_stats.cpp",
    "atomic64.c",
    "posix_stubs.c",
    "crash_log.c",
    "tls_keys.c",
    "wiiu_console.c",
]

# wut.specs links with --emit-relocs (elf2rpl needs the relocations), which ld can't
# combine with the -s that SConstruct adds for builds without debug symbols.
env["LINKFLAGS"] = [flag for flag in env["LINKFLAGS"] if flag != "-s"]

# Route abort(), allocations and sbrk through crash_log.c (crash screen, heap logging).
env.Append(LINKFLAGS=["-Wl,--wrap=abort,--wrap=malloc,--wrap=calloc,--wrap=realloc,--wrap=free,--wrap=_sbrk_r", "-Wl,-Map=bin/godot.wiiu.map"])

# Embed the compiled GX2 shaders (shaders/*.gsh) as C arrays:
# wiiu_shader_<name>[] and wiiu_shader_<name>_size.
def make_shader_c(target, source, env):
    import os

    with open(str(target[0]), "w", encoding="utf-8") as out:
        out.write("// Generated by platform/wiiu/SCsub from shaders/*.gsh. Do not edit.\n")
        out.write("#include <stddef.h>\n#include <stdint.h>\n\n")
        for src in source:
            name = os.path.splitext(os.path.basename(str(src)))[0]
            with open(str(src), "rb") as f:
                data = f.read()
            out.write("const uint8_t wiiu_shader_%s[] __attribute__((aligned(0x100))) = {\n" % name)
            for i in range(0, len(data), 16):
                out.write("\t" + ", ".join("0x%02x" % b for b in data[i : i + 16]) + ",\n")
            out.write("};\nconst size_t wiiu_shader_%s_size = %d;\n\n" % (name, len(data)))
    return None


wiiu_shaders = env.Command(
    "wiiu_shaders.gen.c", ["shaders/texture.gsh", "shaders/color.gsh"], env.Run(make_shader_c)
)

# wiiu_system_font.cpp rasterises the system font with Godot's bundled FreeType.
env.Prepend(CPPPATH=["#thirdparty/freetype/include"])

prog = env.add_program("#bin/godot", wiiu_files + wiiu_shaders)

# Convert the linked ELF into a Cafe OS executable (.rpx). Clang's objects carry
# .note.GNU-stack sections, which elf2rpl can't lay out, so they're stripped first.
rpx = env.Command(
    str(prog[0]).replace(".elf", ".rpx"),
    prog,
    [
        "powerpc-eabi-objcopy --remove-section=.note.GNU-stack $SOURCE ${TARGET.base}.stripped.elf",
        "elf2rpl ${TARGET.base}.stripped.elf $TARGET",
    ],
)
env.Default(rpx)
